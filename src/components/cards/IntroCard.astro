---
import BentoCard from "../BentoCard.astro";
import { Image } from "astro:assets";
---

<BentoCard colSpan="md:col-span-3" classes="text-lg">
    <div class="flex flex-col md:flex-row items-start w-full">
        <div class="flex-1">
            <p class="mb-2em">
                Hey there! I'm <strong>Ben Soyka</strong>, an undergraduate
                computer science student always on plenty of side quests.
            </p>
            <a
                class="btn-primary-outline"
                href="https://assets.bensoyka.com/doc/cv.pdf">View CV</a
            >
        </div>
        <div
            class="rounded-lg overflow-hidden mt-4 md:mt-0 md:ml-4 w-32 h-32 shrink-0"
        >
            <Image
                src="https://assets.bensoyka.com/photo/casual.jpg?s=256"
                alt="Profile photo of Ben Soyka"
                class="h-full w-full object-cover"
                width="128"
                height="128"
            />
        </div>
    </div>
</BentoCard>
